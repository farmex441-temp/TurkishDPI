#include <winver.h>
#include "version.h"

1 24 "TurkishDPI.exe.manifest"
1  ICON "res/app.ico"
11 ICON "res/tray_active.ico"
12 ICON "res/tray_scan.ico"
13 ICON "res/tray_paused.ico"
14 ICON "res/tray_error.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TURKISHDPI_VER_MAJOR,TURKISHDPI_VER_MINOR,TURKISHDPI_VER_PATCH,0
PRODUCTVERSION  TURKISHDPI_VER_MAJOR,TURKISHDPI_VER_MINOR,TURKISHDPI_VER_PATCH,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041F04B0"
    BEGIN
      VALUE "CompanyName",      "TurkishDPI"
      VALUE "FileDescription",  "TurkishDPI - otomatik DPI atlatma"
      VALUE "FileVersion",      TURKISHDPI_VERSION_A
      VALUE "InternalName",     "TurkishDPI"
      VALUE "LegalCopyright",   "Apache-2.0. GoodbyeDPI (ValdikSS), GoodbyeDPI-Turkey (cagritaskn)"
      VALUE "OriginalFilename", "TurkishDPI.exe"
      VALUE "ProductName",      "TurkishDPI"
      VALUE "ProductVersion",   TURKISHDPI_VERSION_A
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x041F, 0x04B0
  END
END
